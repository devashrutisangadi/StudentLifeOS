<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dashboard_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvFlashcardsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textColor="@color/text_charcoal"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvCardCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/btnAddFlashcard"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="14dp"
            android:src="@drawable/ic_plus"
            app:tint="@color/purple_accent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Add flashcard" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnGenerateFromNotes"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_outline_rounded"
            android:text="Generate from notes"
            android:textAllCaps="false"
            android:textColor="@color/purple_accent"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnStudy"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_peach"
            android:text="Study"
            android:textAllCaps="false"
            android:textColor="@color/text_dark"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvFlashcardsEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No flashcards yet. Add one, or generate a set from your notes."
        android:textColor="@color/text_gray"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingTop="40dp"
        android:paddingHorizontal="32dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFlashcards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false" />

</LinearLayout>
