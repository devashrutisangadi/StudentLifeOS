<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/signup_card_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_dark"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvEditNoteTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/text_dark"
                android:textStyle="bold"
                android:textSize="16sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etMarkdownContent"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="@drawable/bg_edittext_signup"
            android:hint="Write your notes here (supports markdown: # headers, **bold**, - lists, etc.)"
            android:gravity="top|start"
            android:padding="14dp"
            android:inputType="textMultiLine"
            android:textColorHint="@color/hint_gray"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSelectedFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_stat_card"
            android:padding="10dp"
            android:textColor="@color/hint_gray"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnAttachFile"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_outline"
            android:text="Attach a file (optional)"
            android:textAllCaps="false"
            android:textColor="@color/text_dark" />

        <ProgressBar
            android:id="@+id/uploadProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSaveNote"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_peach"
            android:text="Save Note"
            android:textAllCaps="false"
            android:textColor="@color/text_dark"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/saveProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>