<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/signup_card_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_dark"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Add Subject"
                android:textColor="@color/text_dark"
                android:textStyle="bold"
                android:textSize="18sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etSubjectName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_edittext_signup"
            android:hint="Subject name"
            android:paddingHorizontal="16dp"
            android:textColorHint="@color/hint_gray"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etSubjectCode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_edittext_signup"
            android:hint="Subject code (e.g. CS205)"
            android:paddingHorizontal="16dp"
            android:textColorHint="@color/hint_gray"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etSubjectFaculty"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_edittext_signup"
            android:hint="Faculty name"
            android:paddingHorizontal="16dp"
            android:textColorHint="@color/hint_gray"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Syllabus units (optional)"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Add a few now, or skip and add them later from the Syllabus Tracker"
            android:textColor="@color/hint_gray"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/unitsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvAddUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="+ Add another unit"
            android:textColor="@color/purple_accent"
            android:textStyle="bold"
            android:textSize="14sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />

        <Button
            android:id="@+id/btnSaveSubject"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_peach"
            android:text="Save Subject"
            android:textAllCaps="false"
            android:textColor="@color/text_dark"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/saveSubjectProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>